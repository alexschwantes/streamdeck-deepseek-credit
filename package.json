{
    "name": "streamdeck-deepseek-credit",
    "author": "Alex Schwantes",
    "license": "MIT",
    "description": "A Stream Deck plugin that displays the current DeepSeek credit balance.",
    "repository": {
        "type": "git",
        "url": "https://github.com/alexschwantes/streamdeck-deepseek-credit.git"
    },
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"node scripts/reload.mjs\"",
        "reload": "node scripts/reload.mjs",
        "promo": "node scripts/promo.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node --test",
        "validate": "npm run build && streamdeck validate io.github.alexschwantes.deepseek-credit.sdPlugin",
        "pack": "npm run build && streamdeck pack io.github.alexschwantes.deepseek-credit.sdPlugin --output dist --force"
    },
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "devDependencies": {
        "@elgato/cli": "^1.9.0",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0"
    }
}
